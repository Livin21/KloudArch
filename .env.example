# ── KloudArch AI assistant ────────────────────────────────────────────────
# Set ONE of these keys and restart `npm run dev`. The assistant picks the
# first configured provider in this order: Anthropic → OpenAI → Google → Gateway.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GATEWAY_API_KEY=          # Vercel AI Gateway (model strings like "anthropic/claude-sonnet-4.6")

# Optional overrides:
# AI_PROVIDER=anthropic        # anthropic | openai | google | gateway (skips auto-detection)
# AI_MODEL=claude-sonnet-4-6   # any model id supported by the chosen provider

# For public/shared deployments: turn the copilot off entirely so visitors
# can't spend your API credits. The studio itself keeps working.
# AI_CHAT_DISABLED=1

# ── Deploy from the studio (CloudFormation) ──────────────────────────────
# The studio deploys designs as CloudFormation stacks using these credentials.
# They can CREATE AND DESTROY real infrastructure — use a sandbox account and
# never expose a deploy-enabled instance publicly.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Turn deployments off entirely (set on shared/public instances):
# DEPLOY_DISABLED=1
