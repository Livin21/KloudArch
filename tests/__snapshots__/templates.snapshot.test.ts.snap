"{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Static Site + CDN — generated by KloudArch Studio. Review before deploying.",
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "WebsiteConfiguration": {
          "IndexDocument": "index.html",
          "ErrorDocument": "error.html"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Site Bucket"
          }
        ]
      }
    },
    "AccessLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/\${AWS::StackName}/accesslogs"
        },
        "RetentionInDays": 30
      }
    },
    "EdgeFirewall": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Scope": "CLOUDFRONT",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "CloudWatchMetricsEnabled": true,
          "MetricName": "edgefirewall",
          "SampledRequestsEnabled": true
        },
        "Rules": [
          {
            "Name": "aws-common",
            "Priority": 1,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "Name": "AWSManagedRulesCommonRuleSet",
                "VendorName": "AWS"
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "aws-common",
              "SampledRequestsEnabled": true
            }
          }
        ]
      }
    },
    "CdnOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "\${AWS::StackName}-oac"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SiteCDN": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Site CDN",
          "PriceClass": "PriceClass_100",
          "DefaultRootObject": "index.html",
          "Origins": [
            {
              "Id": "s3-SiteBucket",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "CdnOriginAccessControl"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "s3-SiteBucket",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "DefaultTTL": 3600,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            }
          },
          "Restrictions": {
            "GeoRestriction": {
              "RestrictionType": "none"
            }
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "WebACLId": {
            "Fn::GetAtt": [
              "EdgeFirewall",
              "Arn"
            ]
          }
        }
      }
    },
    "SiteBucketOacPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "\${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:aws:cloudfront::\${AWS::AccountId}:distribution/\${SiteCDN}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "SiteDNS": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "Name": "www.example.com"
      }
    },
    "SiteDNSSiteCDNRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteDNS"
        },
        "Name": "www.example.com",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "SiteCDN",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2"
        }
      }
    }
  },
  "Outputs": {
    "SiteBucketBucket": {
      "Value": {
        "Ref": "SiteBucket"
      },
      "Description": "Bucket name of Site Bucket"
    },
    "SiteCDNDomain": {
      "Value": {
        "Fn::GetAtt": [
          "SiteCDN",
          "DomainName"
        ]
      },
      "Description": "CDN domain of Site CDN"
    }
  }
}"
`;

exports[`template golden output > static-site → Terraform 1`] = `
"# ╔══════════════════════════════════════════════════════════════════╗
# ║  STATIC SITE + CDN                                               ║
# ║  Generated by KloudArch Studio — review before applying.          ║
# ╚══════════════════════════════════════════════════════════════════╝

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "project" {
  type    = string
  default = "static-site-cdn"
}

variable "aws_region" {
  type    = string
  default = "us-east-1"
}

provider "aws" {
  region = var.aws_region
}

# ── shared ──────────────────────────────────────────────────────
resource "aws_cloudfront_origin_access_control" "main" {
  name                              = "\${var.project}-oac"
  origin_access_control_origin_type = "s3"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

# ── Site Bucket ─────────────────────────────────────────────
resource "aws_s3_bucket" "site_bucket" {
  bucket = "\${var.project}-site-bucket"
}

resource "aws_s3_bucket_versioning" "site_bucket" {
  bucket = aws_s3_bucket.site_bucket.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_website_configuration" "site_bucket" {
  bucket = aws_s3_bucket.site_bucket.id

  index_document { suffix = "index.html" }
  error_document { key = "error.html" }
}

resource "aws_s3_bucket_public_access_block" "site_bucket" {
  bucket                  = aws_s3_bucket.site_bucket.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# ── Access Logs ─────────────────────────────────────────────
resource "aws_cloudwatch_log_group" "access_logs" {
  name              = "/\${var.project}/access-logs"
  retention_in_days = 30
}

# NOTE: add aws_cloudwatch_metric_alarm resources for the services
# connected to "Access Logs" on the canvas.

# ── Edge Firewall ───────────────────────────────────────────
resource "aws_wafv2_web_acl" "edge_firewall" {
  name  = "\${var.project}-edge-firewall"
  scope = "CLOUDFRONT"

  default_action {
    allow {}
  }

  rule {
    name     = "aws-common"
    priority = 1

    override_action {
      none {}
    }

    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesCommonRuleSet"
        vendor_name = "AWS"
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "aws-common"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "edge_firewall"
    sampled_requests_enabled   = true
  }
}

# ── Site CDN ────────────────────────────────────────────────
resource "aws_cloudfront_distribution" "site_cdn" {
  enabled             = true
  comment             = "Site CDN"
  price_class         = "PriceClass_100"
  default_root_object = "index.html"
  web_acl_id          = aws_wafv2_web_acl.edge_firewall.arn

  origin {
    origin_id                = "s3-site_bucket"
    domain_name              = aws_s3_bucket.site_bucket.bucket_regional_domain_name
    origin_access_control_id = aws_cloudfront_origin_access_control.main.id
  }

  default_cache_behavior {
    target_origin_id       = "s3-site_bucket"
    viewer_protocol_policy = "redirect-to-https"
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    default_ttl            = 3600

    forwarded_values {
      query_string = false
      cookies { forward = "none" }
    }
  }

  restrictions {
    geo_restriction { restriction_type = "none" }
  }

  viewer_certificate {
    cloudfront_default_certificate = true
  }
}

# ── Site DNS ────────────────────────────────────────────────
resource "aws_route53_zone" "site_dns" {
  name = "www.example.com"
}

resource "aws_route53_record" "site_dns_site_cdn" {
  zone_id = aws_route53_zone.site_dns.zone_id
  name    = "www.example.com"
  type    = "A"

  alias {
    name                   = aws_cloudfront_distribution.site_cdn.domain_name
    zone_id                = aws_cloudfront_distribution.site_cdn.hosted_zone_id
    evaluate_target_health = false
  }
}

# ── Visitors ────────────────────────────────────────────────
# External actor "Visitors" (web) — nothing to provision.

# ── outputs ─────────────────────────────────────────────────────
output "site_bucket_bucket" {
  description = "Bucket name of Site Bucket"
  value       = aws_s3_bucket.site_bucket.bucket
}

output "site_cdn_domain" {
  description = "CDN domain of Site CDN"
  value       = aws_cloudfront_distribution.site_cdn.domain_name
}

# ── design connections ──────────────────────────────────────────
#   Visitors ──▶ Site DNS   (dns)
#   Site DNS ──▶ Site CDN   (alias)
#   Site CDN ──▶ Site Bucket   (origin (oac))
#   Edge Firewall ──▶ Site CDN   (web acl)
#   Site CDN ──▶ Access Logs   (logs)
"
`;

exports[`template golden output > three-tier → CloudFormation 1`] = `
"{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Three-Tier Web App — generated by KloudArch Studio. Review before deploying.",
  "Parameters": {
    "Al2023AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
      "Description": "Latest Amazon Linux 2023 AMI (resolved via public SSM parameter)"
    }
  },
  "Resources": {
    "AppVPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "App VPC"
          }
        ]
      }
    },
    "PublicA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "AppVPC"
        },
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZone": {
          "Fn::Sub": "\${AWS::Region}a"
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "Public A"
          },
          {
            "Key": "Tier",
            "Value": "public"
          }
        ]
      }
    },
    "PublicB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "AppVPC"
        },
        "CidrBlock": "10.0.2.0/24",
        "AvailabilityZone": {
          "Fn::Sub": "\${AWS::Region}b"
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "Public B"
          },
          {
            "Key": "Tier",
            "Value": "public"
          }
        ]
      }
    },
    "PrivateSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "AppVPC"
        },
        "CidrBlock": "10.0.3.0/24",
        "AvailabilityZone": {
          "Fn::Sub": "\${AWS::Region}a"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "Private Subnet"
          },
          {
            "Key": "Tier",
            "Value": "private"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "Internet Gateway"
          }
        ]
      }
    },
    "InternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "AppVPC"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "AppVPCPublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AppVPC"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "App VPC public"
          }
        ]
      }
    },
    "AppVPCPublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": [
        "InternetGatewayAttachment"
      ],
      "Properties": {
        "RouteTableId": {
          "Ref": "AppVPCPublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicAPublicAssoc": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicA"
        },
        "RouteTableId": {
          "Ref": "AppVPCPublicRouteTable"
        }
      }
    },
    "PublicBPublicAssoc": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicB"
        },
        "RouteTableId": {
          "Ref": "AppVPCPublicRouteTable"
        }
      }
    },
    "NATGatewayEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": [
        "InternetGatewayAttachment"
      ],
      "Properties": {
        "Domain": "vpc"
      }
    },
    "NATGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicB"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "NATGatewayEip",
            "AllocationId"
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "NAT Gateway"
          }
        ]
      }
    },
    "AppVPCPrivateRouteTableB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AppVPC"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "App VPC private b"
          }
        ]
      }
    },
    "AppVPCPrivateRouteTableBRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppVPCPrivateRouteTableB"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NATGateway"
        }
      }
    },
    "PrivateSubnetPrivateAssoc": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnet"
        },
        "RouteTableId": {
          "Ref": "AppVPCPrivateRouteTableB"
        }
      }
    },
    "PrimaryDB": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": "db.t3.micro",
        "AllocatedStorage": "20",
        "MultiAZ": true,
        "MasterUsername": "app",
        "ManageMasterUserPassword": true,
        "DeletionProtection": false
      }
    },
    "SessionCache": {
      "Type": "AWS::ElastiCache::CacheCluster",
      "Properties": {
        "Engine": "redis",
        "CacheNodeType": "cache.t3.micro",
        "NumCacheNodes": 1,
        "Port": 6379
      }
    },
    "Monitoring": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/\${AWS::StackName}/monitoring"
        },
        "RetentionInDays": 30
      }
    },
    "AppServers1": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Al2023AmiId"
        },
        "InstanceType": "t3.medium",
        "SubnetId": {
          "Ref": "PrivateSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WebALBTargetsSecurityGroup"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "App Servers 1"
          }
        ]
      }
    },
    "AppServers2": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Al2023AmiId"
        },
        "InstanceType": "t3.medium",
        "SubnetId": {
          "Ref": "PrivateSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WebALBTargetsSecurityGroup"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "App Servers 2"
          }
        ]
      }
    },
    "WebALBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Ingress for Web ALB",
        "VpcId": {
          "Ref": "AppVPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "WebALBTargetsSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Targets reachable from Web ALB",
        "VpcId": {
          "Ref": "AppVPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourceSecurityGroupId": {
              "Ref": "WebALBSecurityGroup"
            }
          }
        ]
      }
    },
    "WebALB": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": [
          {
            "Ref": "PublicA"
          },
          {
            "Ref": "PublicB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "WebALBSecurityGroup"
          }
        ]
      },
      "DependsOn": [
        "AppVPCPublicRoute"
      ]
    },
    "WebALBTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "instance",
        "VpcId": {
          "Ref": "AppVPC"
        },
        "Targets": [
          {
            "Id": {
              "Ref": "AppServers1"
            }
          },
          {
            "Id": {
              "Ref": "AppServers2"
            }
          }
        ]
      }
    },
    "WebALBListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "WebALB"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "WebALBTargetGroup"
            }
          }
        ]
      }
    },
    "AppDNS": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "Name": "app.example.com"
      }
    },
    "AppDNSWebALBRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "AppDNS"
        },
        "Name": "app.example.com",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "WebALB",
              "DNSName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "WebALB",
              "CanonicalHostedZoneID"
            ]
          }
        }
      }
    }
  },
  "Outputs": {
    "PrimaryDBEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "PrimaryDB",
          "Endpoint.Address"
        ]
      },
      "Description": "Endpoint of Primary DB"
    },
    "WebALBDns": {
      "Value": {
        "Fn::GetAtt": [
          "WebALB",
          "DNSName"
        ]
      },
      "Description": "Public DNS of Web ALB"
    }
  }
}"
`;

exports[`template golden output > three-tier → Terraform 1`] = `
"# ╔══════════════════════════════════════════════════════════════════╗
# ║  THREE-TIER WEB APP                                              ║
# ║  Generated by KloudArch Studio — review before applying.          ║
# ╚══════════════════════════════════════════════════════════════════╝

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "project" {
  type    = string
  default = "three-tier-web-app"
}

variable "aws_region" {
  type    = string
  default = "us-east-1"
}

provider "aws" {
  region = var.aws_region
}

# ── shared ──────────────────────────────────────────────────────
resource "aws_route_table" "app_vpc_public" {
  vpc_id = aws_vpc.app_vpc.id

  tags = { Name = "App VPC public" }
}

resource "aws_route" "app_vpc_public_internet" {
  route_table_id         = aws_route_table.app_vpc_public.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.internet_gateway.id
}

resource "aws_route_table_association" "public_a_public" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.app_vpc_public.id
}

resource "aws_route_table_association" "public_b_public" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.app_vpc_public.id
}

resource "aws_route_table" "app_vpc_private_b" {
  vpc_id = aws_vpc.app_vpc.id

  tags = { Name = "App VPC private b" }
}

resource "aws_route" "app_vpc_private_b_nat" {
  route_table_id         = aws_route_table.app_vpc_private_b.id
  destination_cidr_block = "0.0.0.0/0"
  nat_gateway_id         = aws_nat_gateway.nat_gateway.id
}

resource "aws_route_table_association" "private_subnet_private" {
  subnet_id      = aws_subnet.private_subnet.id
  route_table_id = aws_route_table.app_vpc_private_b.id
}

variable "db_username" {
  type    = string
  default = "app"
}

variable "db_password" {
  type      = string
  sensitive = true
}

data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }
}

# ── App VPC ─────────────────────────────────────────────────
resource "aws_vpc" "app_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = { Name = "App VPC" }
}

# ── Public A ────────────────────────────────────────────────
resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.app_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true

  tags = { Name = "Public A", Tier = "public" }
}

# ── Public B ────────────────────────────────────────────────
resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.app_vpc.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = true

  tags = { Name = "Public B", Tier = "public" }
}

# ── Private Subnet ──────────────────────────────────────────
resource "aws_subnet" "private_subnet" {
  vpc_id                  = aws_vpc.app_vpc.id
  cidr_block              = "10.0.3.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = false

  tags = { Name = "Private Subnet", Tier = "private" }
}

# ── Internet Gateway ────────────────────────────────────────
resource "aws_internet_gateway" "internet_gateway" {
  vpc_id = aws_vpc.app_vpc.id

  tags = { Name = "Internet Gateway" }
}

# ── NAT Gateway ─────────────────────────────────────────────
resource "aws_eip" "nat_gateway" {
  domain = "vpc"
}

resource "aws_nat_gateway" "nat_gateway" {
  allocation_id = aws_eip.nat_gateway.id
  subnet_id     = aws_subnet.public_b.id
  depends_on    = [aws_internet_gateway.internet_gateway]

  tags = { Name = "NAT Gateway" }
}

# ── Primary DB ──────────────────────────────────────────────
resource "aws_db_instance" "primary_db" {
  identifier        = "\${var.project}-primary-db"
  engine            = "postgres"
  engine_version    = "16.4"
  instance_class    = "db.t3.micro"
  allocated_storage = 20
  multi_az          = true

  username = var.db_username
  password = var.db_password

  skip_final_snapshot = true # set false for production
}

# ── Session Cache ───────────────────────────────────────────
resource "aws_elasticache_cluster" "session_cache" {
  cluster_id      = "\${var.project}-session-cache"
  engine          = "redis"
  node_type       = "cache.t3.micro"
  num_cache_nodes = 1
  port            = 6379
}

# ── Monitoring ──────────────────────────────────────────────
resource "aws_cloudwatch_log_group" "monitoring" {
  name              = "/\${var.project}/monitoring"
  retention_in_days = 30
}

# NOTE: add aws_cloudwatch_metric_alarm resources for the services
# connected to "Monitoring" on the canvas.

# ── App Servers ─────────────────────────────────────────────
resource "aws_instance" "app_servers" {
  count         = 2
  ami           = data.aws_ami.al2023.id
  instance_type = "t3.medium"
  subnet_id     = aws_subnet.private_subnet.id
  vpc_security_group_ids = [aws_security_group.web_alb_targets_sg.id]

  tags = { Name = "App Servers \${count.index}" }
}

# ── Web ALB ─────────────────────────────────────────────────
resource "aws_security_group" "web_alb_sg" {
  name_prefix = "\${var.project}-web-alb-"
  vpc_id      = aws_vpc.app_vpc.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "web_alb_targets_sg" {
  name_prefix = "\${var.project}-web-alb-targets-"
  vpc_id      = aws_vpc.app_vpc.id

  ingress {
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.web_alb_sg.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_lb" "web_alb" {
  name               = "\${var.project}-web-alb"
  load_balancer_type = "application"
  internal           = false
  subnets            = [aws_subnet.public_a.id, aws_subnet.public_b.id]
  security_groups    = [aws_security_group.web_alb_sg.id]
}

resource "aws_lb_target_group" "web_alb" {
  name        = "\${var.project}-web-alb-tg"
  port        = 80
  protocol    = "HTTP"
  target_type = "instance"
  vpc_id      = aws_vpc.app_vpc.id
}

resource "aws_lb_listener" "web_alb" {
  load_balancer_arn = aws_lb.web_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web_alb.arn
  }
}

resource "aws_lb_target_group_attachment" "web_alb_app_servers" {
  count            = 2
  target_group_arn = aws_lb_target_group.web_alb.arn
  target_id        = aws_instance.app_servers[count.index].id
  port             = 80
}

# ── App DNS ─────────────────────────────────────────────────
resource "aws_route53_zone" "app_dns" {
  name = "app.example.com"
}

resource "aws_route53_record" "app_dns_web_alb" {
  zone_id = aws_route53_zone.app_dns.zone_id
  name    = "app.example.com"
  type    = "A"

  alias {
    name                   = aws_lb.web_alb.dns_name
    zone_id                = aws_lb.web_alb.zone_id
    evaluate_target_health = true
  }
}

# ── Web Users ───────────────────────────────────────────────
# External actor "Web Users" (web) — nothing to provision.

# ── outputs ─────────────────────────────────────────────────────
output "web_alb_dns" {
  description = "Public DNS of Web ALB"
  value       = aws_lb.web_alb.dns_name
}

# ── design connections ──────────────────────────────────────────
#   Web Users ──▶ App DNS   (dns lookup)
#   App DNS ──▶ Web ALB   (http 80)
#   Web ALB ──▶ App Servers   (http 80)
#   App Servers ──▶ Primary DB   (sql)
#   App Servers ──▶ Session Cache   (cache)
#   App Servers ──▶ Monitoring   (logs)
"
`;
