"{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Event-Driven Pipeline — generated by KloudArch Studio. Review before deploying.",
  "Resources": {
    "OrdersTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "order_id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "order_id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "OrdersQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 30
      }
    },
    "LambdaExecRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "kloudarch-connected-resources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "events:PutEvents",
                  "Resource": {
                    "Fn::GetAtt": [
                      "DomainBus",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "OrdersTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "OrdersQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "IngestFn": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 10,
        "Code": {
          "ZipFile": "exports.handler = async () => ({\\n  statusCode: 200,\\n  body: JSON.stringify({ message: \\"KloudArch placeholder - replace me\\" }),\\n});"
        },
        "Environment": {
          "Variables": {
            "EVENT_BUS": {
              "Fn::GetAtt": [
                "DomainBus",
                "Name"
              ]
            }
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Ingest Fn"
          }
        ]
      }
    },
    "OrderProcessor": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 10,
        "Code": {
          "ZipFile": "def handler(event, context):\\n    return {\\"statusCode\\": 200, \\"body\\": \\"KloudArch placeholder - replace me\\"}"
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Order Processor"
          }
        ]
      }
    },
    "OrdersQueueToOrderProcessor": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "OrdersQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "OrderProcessor"
        },
        "BatchSize": 10
      }
    },
    "AlertsTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {}
    },
    "DomainBus": {
      "Type": "AWS::Events::EventBus",
      "Properties": {
        "Name": {
          "Fn::Sub": "\${AWS::StackName}-app-events"
        }
      }
    },
    "DomainBusOrdersQueueRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventBusName": {
          "Ref": "DomainBus"
        },
        "EventPattern": {
          "source": [
            {
              "prefix": ""
            }
          ]
        },
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "OrdersQueue",
                "Arn"
              ]
            },
            "Id": "target-ordersqueue"
          }
        ]
      }
    },
    "DomainBusOrdersQueueQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "OrdersQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "OrdersQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "DomainBusOrdersQueueRule",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "DomainBusAlertsTopicRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventBusName": {
          "Ref": "DomainBus"
        },
        "EventPattern": {
          "source": [
            {
              "prefix": ""
            }
          ]
        },
        "Targets": [
          {
            "Arn": {
              "Ref": "AlertsTopic"
            },
            "Id": "target-alertstopic"
          }
        ]
      }
    },
    "IngestAPI": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "\${AWS::StackName}-ingestapi"
        },
        "ProtocolType": "HTTP"
      }
    },
    "IngestAPIStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "IngestAPI"
        },
        "StageName": "prod",
        "AutoDeploy": true
      }
    },
    "IngestAPIIngestFnIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "IngestAPI"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "IngestFn",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0"
      }
    },
    "IngestAPIIngestFnRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "IngestAPI"
        },
        "RouteKey": "ANY /ingestfn/{proxy+}",
        "Target": {
          "Fn::Sub": "integrations/\${IngestAPIIngestFnIntegration}"
        }
      }
    },
    "IngestAPIIngestFnPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "IngestFn"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:\${AWS::Region}:\${AWS::AccountId}:\${IngestAPI}/*/*"
        }
      }
    }
  },
  "Outputs": {
    "IngestAPIEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "IngestAPI",
          "ApiEndpoint"
        ]
      },
      "Description": "Invoke URL of Ingest API"
    }
  }
}"
`;

exports[`template golden output > event-pipeline → Terraform 1`] = `
"# ╔══════════════════════════════════════════════════════════════════╗
# ║  EVENT-DRIVEN PIPELINE                                           ║
# ║  Generated by KloudArch Studio — review before applying.          ║
# ╚══════════════════════════════════════════════════════════════════╝

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "project" {
  type    = string
  default = "event-driven-pipeline"
}

variable "aws_region" {
  type    = string
  default = "us-east-1"
}

provider "aws" {
  region = var.aws_region
}

# ── shared ──────────────────────────────────────────────────────
resource "aws_iam_role" "lambda_exec" {
  name = "\${var.project}-lambda-exec"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy_attachment" "lambda_basic" {
  role       = aws_iam_role.lambda_exec.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

# ── Orders Table ────────────────────────────────────────────
resource "aws_dynamodb_table" "orders_table" {
  name         = "\${var.project}-orders-table"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "order_id"

  attribute {
    name = "order_id"
    type = "S"
  }
}

# ── Orders Queue ────────────────────────────────────────────
resource "aws_sqs_queue" "orders_queue" {
  name                       = "\${var.project}-orders-queue"
  visibility_timeout_seconds = 30
}

# ── Alerts Topic ────────────────────────────────────────────
resource "aws_sns_topic" "alerts_topic" {
  name = "\${var.project}-alerts-topic"
}

# ── Ingest Fn ───────────────────────────────────────────────
resource "aws_lambda_function" "ingest_fn" {
  function_name = "\${var.project}-ingest-fn"
  role          = aws_iam_role.lambda_exec.arn
  runtime       = "nodejs22.x"
  handler       = "index.handler"
  memory_size   = 256
  timeout       = 10

  # Package your code at this path before applying.
  filename         = "build/ingest_fn.zip"
  source_code_hash = filebase64sha256("build/ingest_fn.zip")

  environment {
    variables = {
      EVENT_BUS = aws_cloudwatch_event_bus.domain_bus.name
    }
  }
}

# NOTE: grant ingest_fn least-privilege access to the connected resources above.

# ── Order Processor ─────────────────────────────────────────
resource "aws_lambda_function" "order_processor" {
  function_name = "\${var.project}-order-processor"
  role          = aws_iam_role.lambda_exec.arn
  runtime       = "python3.13"
  handler       = "index.handler"
  memory_size   = 512
  timeout       = 10

  # Package your code at this path before applying.
  filename         = "build/order_processor.zip"
  source_code_hash = filebase64sha256("build/order_processor.zip")

  environment {
    variables = {
      TABLE_NAME = aws_dynamodb_table.orders_table.name
    }
  }
}

resource "aws_lambda_event_source_mapping" "orders_queue_to_order_processor" {
  event_source_arn = aws_sqs_queue.orders_queue.arn
  function_name    = aws_lambda_function.order_processor.arn
  batch_size       = 10
}

# NOTE: grant order_processor least-privilege access to the connected resources above.

# ── Domain Bus ──────────────────────────────────────────────
resource "aws_cloudwatch_event_bus" "domain_bus" {
  name = "app-events"
}

resource "aws_cloudwatch_event_rule" "domain_bus_orders_queue" {
  name           = "\${var.project}-to-orders-queue"
  event_bus_name = aws_cloudwatch_event_bus.domain_bus.name

  # TODO: narrow this pattern to the events this target cares about.
  event_pattern = jsonencode({ source = [{ prefix = "" }] })
}

resource "aws_cloudwatch_event_target" "domain_bus_orders_queue" {
  rule           = aws_cloudwatch_event_rule.domain_bus_orders_queue.name
  event_bus_name = aws_cloudwatch_event_bus.domain_bus.name
  arn            = aws_sqs_queue.orders_queue.arn
}

resource "aws_cloudwatch_event_rule" "domain_bus_alerts_topic" {
  name           = "\${var.project}-to-alerts-topic"
  event_bus_name = aws_cloudwatch_event_bus.domain_bus.name

  # TODO: narrow this pattern to the events this target cares about.
  event_pattern = jsonencode({ source = [{ prefix = "" }] })
}

resource "aws_cloudwatch_event_target" "domain_bus_alerts_topic" {
  rule           = aws_cloudwatch_event_rule.domain_bus_alerts_topic.name
  event_bus_name = aws_cloudwatch_event_bus.domain_bus.name
  arn            = aws_sns_topic.alerts_topic.arn
}

# ── Ingest API ──────────────────────────────────────────────
resource "aws_apigatewayv2_api" "ingest_api" {
  name          = "\${var.project}-ingest-api"
  protocol_type = "HTTP"
}

resource "aws_apigatewayv2_stage" "ingest_api" {
  api_id      = aws_apigatewayv2_api.ingest_api.id
  name        = "prod"
  auto_deploy = true
}

resource "aws_apigatewayv2_integration" "ingest_api_ingest_fn" {
  api_id                 = aws_apigatewayv2_api.ingest_api.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.ingest_fn.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "ingest_api_ingest_fn" {
  api_id    = aws_apigatewayv2_api.ingest_api.id
  route_key = "ANY /ingest-fn/{proxy+}"
  target    = "integrations/\${aws_apigatewayv2_integration.ingest_api_ingest_fn.id}"
}

resource "aws_lambda_permission" "ingest_api_ingest_fn" {
  statement_id  = "AllowAPIGw_ingest_fn"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.ingest_fn.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "\${aws_apigatewayv2_api.ingest_api.execution_arn}/*/*"
}

# ── Event Producers ─────────────────────────────────────────
# External actor "Event Producers" (api clients) — nothing to provision.

# ── outputs ─────────────────────────────────────────────────────
output "ingest_api_endpoint" {
  description = "Invoke URL of Ingest API"
  value       = aws_apigatewayv2_stage.ingest_api.invoke_url
}

# ── design connections ──────────────────────────────────────────
#   Event Producers ──▶ Ingest API   (events in)
#   Ingest API ──▶ Ingest Fn   (post /events)
#   Ingest Fn ──▶ Domain Bus   (publish)
#   Domain Bus ──▶ Orders Queue   (rule: orders)
#   Domain Bus ──▶ Alerts Topic   (rule: alerts)
#   Orders Queue ──▶ Order Processor   (batch trigger)
#   Order Processor ──▶ Orders Table   (persist)
"
`;

exports[`template golden output > serverless-api → CloudFormation 1`] = `
"{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Serverless API — generated by KloudArch Studio. Review before deploying.",
  "Resources": {
    "ResultsBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Results Bucket"
          }
        ]
      }
    },
    "AppTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "JobsQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 30
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "MfaConfiguration": "OPTIONAL",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "RequireUppercase": true
          }
        }
      }
    },
    "UserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        }
      }
    },
    "LogsAlarms": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/\${AWS::StackName}/logsalarms"
        },
        "RetentionInDays": 30
      }
    },
    "LambdaExecRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "kloudarch-connected-resources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AppTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JobsQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ResultsBucket",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "\${ResultsBucket.Arn}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JobsQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiHandler": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 10,
        "Code": {
          "ZipFile": "exports.handler = async () => ({\\n  statusCode: 200,\\n  body: JSON.stringify({ message: \\"KloudArch placeholder - replace me\\" }),\\n});"
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "AppTable"
            },
            "QUEUE_URL": {
              "Ref": "JobsQueue"
            }
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Api Handler"
          }
        ]
      }
    },
    "JobWorker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 120,
        "Code": {
          "ZipFile": "exports.handler = async () => ({\\n  statusCode: 200,\\n  body: JSON.stringify({ message: \\"KloudArch placeholder - replace me\\" }),\\n});"
        },
        "Environment": {
          "Variables": {
            "BUCKET_NAME": {
              "Ref": "ResultsBucket"
            }
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Job Worker"
          }
        ]
      }
    },
    "JobsQueueToJobWorker": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "JobsQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "JobWorker"
        },
        "BatchSize": 10
      }
    },
    "PublicAPI": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "\${AWS::StackName}-publicapi"
        },
        "ProtocolType": "HTTP"
      }
    },
    "PublicAPIStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "PublicAPI"
        },
        "StageName": "prod",
        "AutoDeploy": true
      }
    },
    "PublicAPIApiHandlerIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "PublicAPI"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiHandler",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0"
      }
    },
    "PublicAPIApiHandlerRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "PublicAPI"
        },
        "RouteKey": "ANY /apihandler/{proxy+}",
        "Target": {
          "Fn::Sub": "integrations/\${PublicAPIApiHandlerIntegration}"
        }
      }
    },
    "PublicAPIApiHandlerPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiHandler"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:\${AWS::Region}:\${AWS::AccountId}:\${PublicAPI}/*/*"
        }
      }
    },
    "PublicAPIJwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "PublicAPI"
        },
        "AuthorizerType": "JWT",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "Name": "cognito-jwt",
        "JwtConfiguration": {
          "Audience": [
            {
              "Ref": "UserPoolClient"
            }
          ],
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.\${AWS::Region}.amazonaws.com/\${UserPool}"
          }
        }
      }
    }
  },
  "Outputs": {
    "ResultsBucketBucket": {
      "Value": {
        "Ref": "ResultsBucket"
      },
      "Description": "Bucket name of Results Bucket"
    },
    "PublicAPIEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "PublicAPI",
          "ApiEndpoint"
        ]
      },
      "Description": "Invoke URL of Public API"
    }
  }
}"
`;

exports[`template golden output > serverless-api → Terraform 1`] = `
"# ╔══════════════════════════════════════════════════════════════════╗
# ║  SERVERLESS API                                                  ║
# ║  Generated by KloudArch Studio — review before applying.          ║
# ╚══════════════════════════════════════════════════════════════════╝

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "project" {
  type    = string
  default = "serverless-api"
}

variable "aws_region" {
  type    = string
  default = "us-east-1"
}

provider "aws" {
  region = var.aws_region
}

# ── shared ──────────────────────────────────────────────────────
resource "aws_iam_role" "lambda_exec" {
  name = "\${var.project}-lambda-exec"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy_attachment" "lambda_basic" {
  role       = aws_iam_role.lambda_exec.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

# ── Results Bucket ──────────────────────────────────────────
resource "aws_s3_bucket" "results_bucket" {
  bucket = "\${var.project}-results-bucket"
}

resource "aws_s3_bucket_versioning" "results_bucket" {
  bucket = aws_s3_bucket.results_bucket.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_public_access_block" "results_bucket" {
  bucket                  = aws_s3_bucket.results_bucket.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# ── App Table ───────────────────────────────────────────────
resource "aws_dynamodb_table" "app_table" {
  name         = "\${var.project}-app-table"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"

  attribute {
    name = "id"
    type = "S"
  }
}

# ── Jobs Queue ──────────────────────────────────────────────
resource "aws_sqs_queue" "jobs_queue" {
  name                       = "\${var.project}-jobs-queue"
  visibility_timeout_seconds = 30
}

# ── User Pool ───────────────────────────────────────────────
resource "aws_cognito_user_pool" "user_pool" {
  name = "\${var.project}-user-pool"

  mfa_configuration = "OPTIONAL"

  software_token_mfa_configuration {
    enabled = true
  }

  password_policy {
    minimum_length    = 12
    require_lowercase = true
    require_numbers   = true
    require_symbols   = true
    require_uppercase = true
  }
}

resource "aws_cognito_user_pool_client" "user_pool" {
  name         = "\${var.project}-client"
  user_pool_id = aws_cognito_user_pool.user_pool.id
}

# ── Logs & Alarms ───────────────────────────────────────────
resource "aws_cloudwatch_log_group" "logs_alarms" {
  name              = "/\${var.project}/logs-alarms"
  retention_in_days = 30
}

# NOTE: add aws_cloudwatch_metric_alarm resources for the services
# connected to "Logs & Alarms" on the canvas.

# ── Api Handler ─────────────────────────────────────────────
resource "aws_lambda_function" "api_handler" {
  function_name = "\${var.project}-api-handler"
  role          = aws_iam_role.lambda_exec.arn
  runtime       = "nodejs22.x"
  handler       = "index.handler"
  memory_size   = 512
  timeout       = 10

  # Package your code at this path before applying.
  filename         = "build/api_handler.zip"
  source_code_hash = filebase64sha256("build/api_handler.zip")

  environment {
    variables = {
      TABLE_NAME = aws_dynamodb_table.app_table.name
      QUEUE_URL = aws_sqs_queue.jobs_queue.url
    }
  }
}

# NOTE: grant api_handler least-privilege access to the connected resources above.

# ── Job Worker ──────────────────────────────────────────────
resource "aws_lambda_function" "job_worker" {
  function_name = "\${var.project}-job-worker"
  role          = aws_iam_role.lambda_exec.arn
  runtime       = "nodejs22.x"
  handler       = "index.handler"
  memory_size   = 256
  timeout       = 120

  # Package your code at this path before applying.
  filename         = "build/job_worker.zip"
  source_code_hash = filebase64sha256("build/job_worker.zip")

  environment {
    variables = {
      BUCKET_NAME = aws_s3_bucket.results_bucket.bucket
    }
  }
}

resource "aws_lambda_event_source_mapping" "jobs_queue_to_job_worker" {
  event_source_arn = aws_sqs_queue.jobs_queue.arn
  function_name    = aws_lambda_function.job_worker.arn
  batch_size       = 10
}

# NOTE: grant job_worker least-privilege access to the connected resources above.

# ── Public API ──────────────────────────────────────────────
resource "aws_apigatewayv2_api" "public_api" {
  name          = "\${var.project}-public-api"
  protocol_type = "HTTP"
}

resource "aws_apigatewayv2_stage" "public_api" {
  api_id      = aws_apigatewayv2_api.public_api.id
  name        = "prod"
  auto_deploy = true
}

resource "aws_apigatewayv2_integration" "public_api_api_handler" {
  api_id                 = aws_apigatewayv2_api.public_api.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.api_handler.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "public_api_api_handler" {
  api_id    = aws_apigatewayv2_api.public_api.id
  route_key = "ANY /api-handler/{proxy+}"
  target    = "integrations/\${aws_apigatewayv2_integration.public_api_api_handler.id}"
}

resource "aws_lambda_permission" "public_api_api_handler" {
  statement_id  = "AllowAPIGw_api_handler"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.api_handler.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "\${aws_apigatewayv2_api.public_api.execution_arn}/*/*"
}

resource "aws_apigatewayv2_authorizer" "public_api_jwt" {
  api_id           = aws_apigatewayv2_api.public_api.id
  authorizer_type  = "JWT"
  identity_sources = ["$request.header.Authorization"]
  name             = "cognito-jwt"

  jwt_configuration {
    audience = [aws_cognito_user_pool_client.user_pool.id]
    issuer   = "https://\${aws_cognito_user_pool.user_pool.endpoint}"
  }
}

# ── API Clients ─────────────────────────────────────────────
# External actor "API Clients" (api clients) — nothing to provision.

# ── outputs ─────────────────────────────────────────────────────
output "results_bucket_bucket" {
  description = "Bucket name of Results Bucket"
  value       = aws_s3_bucket.results_bucket.bucket
}

output "public_api_endpoint" {
  description = "Invoke URL of Public API"
  value       = aws_apigatewayv2_stage.public_api.invoke_url
}

# ── design connections ──────────────────────────────────────────
#   API Clients ──▶ Public API   (https)
#   User Pool ──▶ Public API   (jwt authorizer)
#   Public API ──▶ Api Handler   (any /api)
#   Api Handler ──▶ App Table   (read/write)
#   Api Handler ──▶ Jobs Queue   (enqueue)
#   Jobs Queue ──▶ Job Worker   (event source)
#   Job Worker ──▶ Results Bucket   (store results)
#   Api Handler ──▶ Logs & Alarms   (logs)
"
`;

